{"id": "q01-q2-playbook-owner", "text": "Who owns the active Q2 Terminal Readiness Playbook?", "paraphrase": "Which operations lead maintains the second-quarter pier readiness runbook?", "type": "direct", "facts": [{"claim": "Juno Castillo owns the active Q2 Terminal Readiness Playbook.", "aliases": ["q2 terminal readiness", "terminal readiness playbook", "juno castillo"]}], "marshmallow": {"expected_node_ids": ["juno-castillo", "plan-q2-terminal-readiness"]}}
{"id": "q02-p9-gate-codename", "text": "What's the project codename for the Pier-9 Gate Retrofit?", "paraphrase": "Which tracker shorthand labels berth-nine automated entry hardware work?", "type": "direct", "facts": [{"claim": "Pier-9 Gate Retrofit codename is P9-GATE.", "aliases": ["p9-gate", "pier-9 gate retrofit", "gate retrofit"]}], "marshmallow": {"expected_node_ids": ["p9-gate-retrofit"]}}
{"id": "q03-p9-gang-codename", "text": "What's the codename for the Pier-9 Gangway Replacement project?", "paraphrase": "Which ID covers the passenger boarding bridge swap at dock nine?", "type": "direct", "facts": [{"claim": "Pier-9 Gangway Replacement codename is P9-GANG.", "aliases": ["p9-gang", "pier-9 gangway replacement", "gangway replacement"]}], "marshmallow": {"expected_node_ids": ["p9-gang-replacement"]}}
{"id": "q04-pier9-vendor-split", "text": "Which vendors are assigned to P9-GATE and P9-GANG after the procurement split?", "paraphrase": "Who supplies automated fare hardware versus hydraulic boarding equipment at the ninth pier?", "type": "direct", "facts": [{"claim": "Turnstile Dynamics is the P9-GATE vendor.", "aliases": ["turnstile dynamics", "gate vendor", "p9-gate vendor"]}, {"claim": "Bridgeway Hoist is the P9-GANG vendor.", "aliases": ["bridgeway hoist", "gangway vendor", "p9-gang vendor"]}], "marshmallow": {"expected_node_ids": ["decision-vendor-split", "turnstile-dynamics", "bridgeway-hoist"]}}
{"id": "q05-kelwick-superseded", "text": "Who was the original Pier 9 single-contractor vendor, and when was that plan retired?", "paraphrase": "Which marine outfit held the unified dock-nine envelope before scope split ended it?", "type": "direct", "facts": [{"claim": "The superseded Pier 9 Single-Contractor Plan named Kelwick Marine for all Pier 9 work.", "aliases": ["kelwick marine", "single-contractor plan", "single contractor plan", "pier 9 single-contractor", "pier 9 single contractor"]}, {"claim": "Victor Dunn superseded the single-contractor plan on 2026-05-06 because gate and gangway scopes diverged.", "aliases": ["superseded single-contractor", "scope divergence", "2026-05-06"]}], "marshmallow": {"expected_node_ids": ["kelwick-marine", "plan-pier9-single-contractor", "decision-supersede-single-contractor"]}}
{"id": "q06-harborpass-golive", "text": "What's the HarborPass 2.0 go-live target date?", "paraphrase": "When does the ticketing cutover aim to flip live?", "type": "direct", "facts": [{"claim": "HarborPass 2.0 go-live target date is 2026-06-02.", "aliases": ["harborpass 2.0", "go-live 2026-06-02", "june 2 go-live"]}], "marshmallow": {"expected_node_ids": ["hp-migrate", "harborpass-2-0", "decision-hp-golive-target"]}}
{"id": "q07-pier3-float-dive", "text": "What triggered the Pier 3 partial berth closure in late April, and when was dive inspection overtime approved?", "paraphrase": "Why did dock three shrink available slips after the April 22 sensor fault, and who signed extended underwater crew hours?", "type": "direct", "facts": [{"claim": "Pier 3 float switch failure on 2026-04-22 triggered partial berth closure.", "aliases": ["float switch failure", "pier 3 berth closure", "2026-04-22"]}, {"claim": "Hana Suzuki authorized dive inspection overtime on 2026-04-23.", "aliases": ["dive inspection overtime", "pier 3 overtime", "2026-04-23"]}], "marshmallow": {"expected_node_ids": ["pier-3", "decision-pier3-berth-closure", "hana-suzuki"]}}
{"id": "q08-elena-drydock", "text": "When did Elena approve the SG-REFIT drydock window for MV Seaglass?", "paraphrase": "What start date did the fleet maintenance director clear for pulling Seaglass into berth four?", "type": "direct", "facts": [{"claim": "Elena Vasquez approved SG-REFIT drydock window starting 2026-05-18.", "aliases": ["sg-refit drydock", "drydock window 2026-05-18", "seaglass drydock"]}], "marshmallow": {"expected_node_ids": ["elena-vasquez", "sg-refit", "decision-drydock-window"]}}
{"id": "q09-victor-thrust-bearing", "text": "What must Victor deliver before SG-REFIT hull penetration can begin?", "paraphrase": "Which spare part does the chief engineer insist arrive dockside ahead of cutting into the hull?", "type": "direct", "facts": [{"claim": "Victor Hale requires spare thrust bearing delivery before hull penetration on SG-REFIT.", "aliases": ["thrust bearing", "hull penetration", "victor hale"]}], "marshmallow": {"expected_node_ids": ["victor-hale", "rule-thrust-bearing-before-hull"]}}
