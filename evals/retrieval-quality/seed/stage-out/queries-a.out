{"id": "q11-life-vest-interval", "text": "How often did Priya mandate life-vest spot checks during SSB-DRILL?", "paraphrase": "What interval did the safety lead require between flotation gear inspections during surge barrier exercises?", "type": "direct", "facts": [{"claim": "Priya Nandakumar mandated life-vest spot checks every 45 minutes during SSB-DRILL.", "aliases": ["life-vest spot checks", "45 minutes", "ssb-drill"]}], "marshmallow": {"expected_node_ids": ["priya-nandakumar", "rule-life-vest-checks"]}}
{"id": "q12-drill-weekends", "text": "What are the three SSB-DRILL simulation weekend dates?", "paraphrase": "On which Saturdays and Sundays will storm barrier exercises run in late May and early June?", "type": "direct", "facts": [{"claim": "SSB-DRILL has three simulation weekends: 2026-05-24, 2026-05-31, and 2026-06-07.", "aliases": ["storm surge barrier drill", "may 24 drill", "three simulation weekends"]}], "marshmallow": {"expected_node_ids": ["ssb-drill", "simulation-weekends", "decision-drill-weekends"]}}
{"id": "q13-coverage-matrix-drift", "text": "How many deckhands per pier does Juno's edited coverage matrix show versus Priya's source notes?", "paraphrase": "What headcount mismatch exists between the working weekend roster Juno altered and the compliance packet Priya filed?", "type": "direct", "facts": [{"claim": "Juno manually edited Storm Surge Weekend Coverage Matrix to 3 deckhands per pier.", "aliases": ["weekend coverage matrix", "3 deckhands", "manually edited"]}, {"claim": "Source notes for the coverage matrix originally specified 4 deckhands per pier.", "aliases": ["source notes", "4 deckhands", "coverage matrix"]}], "marshmallow": {"expected_node_ids": ["plan-storm-surge-coverage-matrix", "decision-matrix-manual-edit", "rule-coverage-source-notes"]}}
{"id": "q14-elena-grating", "text": "What aluminum grating grade did Elena specify for the Pier 7 accessibility ramp?", "paraphrase": "Which alloy rating did the passenger services lead lock for dock seven walkway panels?", "type": "direct", "facts": [{"claim": "P7-RAMP aluminum grating spec is grade 6061-T6 per Elena Crane.", "aliases": ["6061-t6", "aluminum grating", "pier 7 ramp"]}], "marshmallow": {"expected_node_ids": ["elena-crane", "p7-ramp", "decision-grating-spec-6061"]}}
