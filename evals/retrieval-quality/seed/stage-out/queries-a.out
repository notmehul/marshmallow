{"id": "q16-friday-harbor-diversion", "text": "Where did Marcus divert the Friday Harbor run on May 15 for ramp work?", "paraphrase": "Which alternate pier hosted the island route when dock seven accessibility work blocked its berth?", "type": "direct", "facts": [{"claim": "Marcus Holt shifted the Friday Harbor run to Pier 5 on 2026-05-15 for ramp work.", "aliases": ["friday harbor run", "pier 5 diversion", "2026-05-15"]}], "marshmallow": {"expected_node_ids": ["marcus-holt", "pier-5", "decision-friday-harbor-diversion"]}}
{"id": "q17-change-order-cap", "text": "What change-order spending cap did Glenn set for P9-GATE without VP sign-off?", "paraphrase": "How much procurement finance allows on pier-nine fare hardware extras before executive approval?", "type": "direct", "facts": [{"claim": "Glenn Wexler capped P9-GATE change orders at $18,400 without VP sign-off.", "aliases": ["change order cap", "$18400", "p9-gate"]}], "marshmallow": {"expected_node_ids": ["glenn-wexler", "decision-change-order-cap"]}}
